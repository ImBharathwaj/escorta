generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  role            String   // client | escort | admin
  email           String?  @unique
  phone           String?
  displayName     String?  @map("display_name")
  avatarUrl       String?  @map("avatar_url")
  passwordHash    String   @map("password_hash")
  isActive        Boolean  @default(true) @map("is_active")
  isBanned        Boolean  @default(false) @map("is_banned")
  isPremiumMember Boolean  @default(false) @map("is_premium_member")
  credits         Int      @default(0)
  emailVerifiedAt DateTime? @map("email_verified_at")
  deletedAt       DateTime? @map("deleted_at")
  lastLogin       DateTime? @map("last_login")
  lastActiveAt    DateTime? @map("last_active_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  escortProfile     EscortProfile?
  bookingsAsClient  Booking[]       @relation("ClientBookings")
  sentMessages      Message[]
  sexterMessages    SexterMessage[]
  sexterSessionsAsClient SexterSession[] @relation("SexterClient")
  emailVerificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model EscortProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aliasName        String   @map("alias_name")
  age              Int?
  city             String?
  country          String?
  description      String?
  pricePerHour     Int?     @map("price_per_hour")
  gender           String?  // female | male | non-binary | other
  isVerified       Boolean  @default(false) @map("is_verified")
  isGenderVerified Boolean  @default(false) @map("is_gender_verified") // admin-verified gender
  isActive         Boolean  @default(true) @map("is_active")
  isPremium        Boolean  @default(false) @map("is_premium")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  photos         EscortPhoto[]
  services       EscortService[]
  adultServices  EscortAdultService[]
  availability   EscortAvailability[]
  bookings       Booking[]
  sexterSessions SexterSession[]
}

model Service {
  id   String @id @default(uuid())
  name String @unique

  escorts EscortService[]
}

model EscortService {
  escortId  String @map("escort_id")
  serviceId String @map("service_id")
  escort    EscortProfile @relation(fields: [escortId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([escortId, serviceId])
}

model AdultService {
  id   String @id @default(uuid())
  name String @unique

  escorts EscortAdultService[]
}

model EscortAdultService {
  escortId       String @map("escort_id")
  adultServiceId String @map("adult_service_id")
  escort         EscortProfile @relation(fields: [escortId], references: [id], onDelete: Cascade)
  adultService   AdultService @relation(fields: [adultServiceId], references: [id], onDelete: Cascade)

  @@id([escortId, adultServiceId])
}

model EscortPhoto {
  id         String   @id @default(uuid())
  escortId   String   @map("escort_id")
  escort     EscortProfile @relation(fields: [escortId], references: [id], onDelete: Cascade)
  imageUrl   String   @map("image_url")
  isPrimary  Boolean  @default(false) @map("is_primary")
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
}

model EscortAvailability {
  id        String   @id @default(uuid())
  escortId  String   @map("escort_id")
  escort    EscortProfile @relation(fields: [escortId], references: [id], onDelete: Cascade)
  dayOfWeek Int?    @map("day_of_week")
  startTime String? @map("start_time") // Prisma doesn't have Time, use String
  endTime   String? @map("end_time")
}

model Booking {
  id              String   @id @default(uuid())
  escortId        String   @map("escort_id")
  clientId        String   @map("client_id")
  escort          EscortProfile @relation(fields: [escortId], references: [id])
  client          User     @relation("ClientBookings", fields: [clientId], references: [id])
  bookingTime     DateTime? @map("booking_time")
  durationMinutes Int?     @map("duration_minutes")
  status          String   @default("pending") // pending | accepted | rejected | cancelled | completed
  price           Int?
  message         String?
  createdAt       DateTime @default(now()) @map("created_at")

  messages       Message[]
  sexterSessions SexterSession[]
}

model Message {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  senderId  String   @map("sender_id")
  message   String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
}

// Session-based sexter: standalone from connections. clientId+escortId for new flow; bookingId legacy.
model SexterSession {
  id        String         @id @default(uuid())
  bookingId String?        @map("booking_id")
  booking   Booking?       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId  String?        @map("client_id")
  client    User?          @relation("SexterClient", fields: [clientId], references: [id], onDelete: Cascade)
  escortId  String?        @map("escort_id")
  escort    EscortProfile? @relation(fields: [escortId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")
  expiresAt DateTime       @default(now()) @map("expires_at")
  endedAt   DateTime?      @map("ended_at")
  messages  SexterMessage[]
}

model SexterMessage {
  id              String        @id @default(uuid())
  sexterSessionId String        @map("sexter_session_id")
  session         SexterSession @relation(fields: [sexterSessionId], references: [id], onDelete: Cascade)
  senderId        String        @map("sender_id")
  sender          User          @relation(fields: [senderId], references: [id])
  message         String        @default("")
  attachmentUrl   String?       @map("attachment_url")
  attachmentType  String?       @map("attachment_type") // "image" | "video"
  createdAt       DateTime     @default(now()) @map("created_at")
}

// Stores email of deleted accounts for company records; not exposed to clients.
model DeletedUserEmail {
  id        String   @id @default(uuid())
  email     String?  @map("email")
  phone     String?  @map("phone")
  role      String?  @map("role")
  deletedAt DateTime @default(now()) @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
}
